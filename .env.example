# Shared secrets — copy to .env (never commit .env)

SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

POSTGRES_USER=cable
POSTGRES_PASSWORD=cable_dev_change_me
POSTGRES_DB=cable
DATABASE_URL=postgresql://cable:cable_dev_change_me@localhost:5432/cable

# Browser → API (local Next). Behind Caddy use https://your.domain/api or same-origin proxy.
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost

# Legacy Streamlit (optional)
APP_PASSWORD=
